# Compilacion de pruebas en el host (macOS/Linux), sin toolchain de Dreamcast.
CC ?= cc
CFLAGS ?= -O2 -Wall -Wextra -std=c99

test: build/test_c3x_float build/cusa_host
	./build/test_c3x_float


build/test_c3x_float: tests/test_c3x_float.c src/c3x/c3x.h
	@mkdir -p build
	$(CC) $(CFLAGS) -o $@ tests/test_c3x_float.c -lm

HOST_SRCS = src/host/main_host.c src/c3x/interp.c src/vunit/mem.c src/vunit/video.c

build/cusa_host: $(HOST_SRCS) src/c3x/c3x.h src/vunit/mem.h
	@mkdir -p build
	$(CC) $(CFLAGS) -o $@ $(HOST_SRCS) -lm

host: build/cusa_host

# Codigo recompilado: requiere generated/recomp (tools/c31recomp.py)
RECOMP_DIR ?= generated/recomp
-include $(RECOMP_DIR)/files.mk
RECOMP_HOST_SRCS = src/host/main_recomp.c src/recomp/rt.c src/recomp/hle.c src/vunit/mem.c src/vunit/video.c src/c3x/interp.c

build/cusa_recomp: $(RECOMP_HOST_SRCS) $(RECOMP_SRCS) src/recomp/rt.h
	@mkdir -p build
	$(CC) $(CFLAGS) -Wno-unused-label -Wno-parentheses-equality -Isrc/recomp -o $@ $(RECOMP_HOST_SRCS) $(RECOMP_SRCS) -lm

recomp: build/cusa_recomp

build/cusa_profile: $(RECOMP_HOST_SRCS) $(RECOMP_SRCS) src/recomp/rt.h
	@mkdir -p build
	$(CC) $(CFLAGS) -DRT_TRACE_ON -Wno-unused-label -Wno-parentheses-equality -Isrc/recomp -o $@ $(RECOMP_HOST_SRCS) $(RECOMP_SRCS) -lm

profile: build/cusa_profile

DIFF_SRCS = src/host/difftest.c src/recomp/rt.c src/recomp/hle.c src/vunit/mem.c src/vunit/video.c src/c3x/interp.c

build/cusa_difftest: $(DIFF_SRCS) $(RECOMP_SRCS) src/recomp/rt.h
	@mkdir -p build
	$(CC) $(CFLAGS) -DVU_SWAPPABLE -DRT_TRACE_ON -Wno-unused-label -Wno-parentheses-equality -Isrc/recomp -o $@ $(DIFF_SRCS) $(RECOMP_SRCS) -lm

difftest: build/cusa_difftest

clean:
	rm -rf build

.PHONY: test host recomp difftest clean

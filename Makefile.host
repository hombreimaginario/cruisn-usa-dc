# Compilacion de pruebas en el host (macOS/Linux), sin toolchain de Dreamcast.
CC ?= cc
CFLAGS ?= -O2 -Wall -Wextra -std=c99

test: build/test_c3x_float build/mem.o
	./build/test_c3x_float

build/mem.o: src/vunit/mem.c src/vunit/mem.h
	@mkdir -p build
	$(CC) $(CFLAGS) -c -o $@ src/vunit/mem.c

build/test_c3x_float: tests/test_c3x_float.c src/c3x/c3x.h
	@mkdir -p build
	$(CC) $(CFLAGS) -o $@ tests/test_c3x_float.c -lm

clean:
	rm -rf build

.PHONY: test clean
